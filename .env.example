# Application Settings
APP_NAME="Driving Licence AI"
APP_ENV="development"
CORS_ORIGINS="*"

# Database Configuration (PostgreSQL connection string with pgvector)
DATABASE_URL="postgresql://postgres:password@localhost:5432/driving_licence_db"

# Supabase Configuration
SUPABASE_URL="https://your-supabase-project.supabase.co"
# Supabase Service Key for administrative Storage and DB access.
# Both SUPABASE_SERVICE_KEY and SUPABASE_SERVICE_ROLE_KEY are supported.
SUPABASE_SERVICE_KEY="your-supabase-service-role-key"

# JWT Authentication
JWT_SECRET_KEY="your-super-secret-jwt-key-change-this-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Supabase Storage Configuration
STORAGE_BUCKET_NAME="documents"

# AWS Textract OCR Configuration (Optional)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
OCR_PROVIDER="auto"
TESSERACT_CMD="/usr/bin/tesseract"

# Google Gemini AI Configuration
# Both GEMINI_API_KEY and GOOGLE_API_KEY are supported.
GEMINI_API_KEY="your_gemini_api_key"
GEMINI_GENERATION_MODEL="gemini-3.6-flash"
GEMINI_EMBEDDING_MODEL="gemini-embedding-001"

# Text Chunking Configuration
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# Embedding Configuration
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=20

# RAG Configuration
RAG_MAX_CONTEXT_LENGTH=4000
RAG_DEFAULT_TOP_K=5
RAG_MAX_TOP_K=20
RAG_TEMPERATURE=0.0
